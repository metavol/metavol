---
// metavol brand mark — the two peach circles from the official logo.
// Use this small mark in headers, favicons and footers.
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className = 'brand-mark' } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <!-- body -->
  <circle cx="30" cy="40" r="14" fill="#FAC090" />
  <!-- head (offset right, matching the official logo) -->
  <circle cx="40" cy="22" r="9" fill="#FAC090" />
</svg>
