---
import SnowmanMark from './SnowmanMark.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const homeHref = lang === 'en' ? '/en/' : '/';
---
<div class="topstrip">
  <header class="header">
    <a href={homeHref} class="brand" aria-label="metavol home">
      <SnowmanMark />
      <span class="brand-text">metavol</span>
    </a>
    <nav class="primary" aria-label="Primary">
      <a href="#products">{t('nav.products')}</a>
      <a href="#news">{t('nav.news')}</a>
      <a href="#publications">{t('nav.publications')}</a>
      <a href="#download">{t('nav.download')}</a>
      <a href="#instruction">{t('nav.instruction')}</a>
      <a href="#citation">{t('nav.citation')}</a>
    </nav>
    <div class="lang">
      <a href="/" class={lang === 'ja' ? 'active' : ''}>JA</a>
      <span>/</span>
      <a href="/en/" class={lang === 'en' ? 'active' : ''}>EN</a>
    </div>
  </header>
</div>
